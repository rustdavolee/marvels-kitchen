# Copy to .env locally. Do not commit the real .env or production secrets.
HOST=127.0.0.1
PORT=8080
# Durable SQLite file; relative paths resolve from the API working directory.
DB_PATH=marvels-kitchen.sqlite3
# Alternatively provide a complete SQLx URL (overrides DB_PATH):
# DATABASE_URL=sqlite://marvels-kitchen.sqlite3?mode=rwc
ADMIN_API_KEY=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
